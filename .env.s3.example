# Object-store admin key that only SeaweedFS (to verify signatures) and its bucket init may hold (TASK-0003 #7).
# Placeholders only. scripts/dev/init-env.sh copies this to .secrets/s3.env and fills every empty value with a random one.
# The audit-anchor key moved to .env.anchor.example (P1-50).

# SeaweedFS admin identity: creates buckets and can bypass governance retention. Not given to the application.
S3_ADMIN_ACCESS_KEY=
S3_ADMIN_SECRET_KEY=
