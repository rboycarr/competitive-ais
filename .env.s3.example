# Object-store keys that only SeaweedFS (to verify signatures) and its bucket init may hold (TASK-0003 #7).
# Placeholders only. scripts/dev/init-env.sh copies this to .env.s3 and fills every empty value with a random one.

# SeaweedFS admin identity: creates buckets and can bypass governance retention. Not given to the application.
S3_ADMIN_ACCESS_KEY=
S3_ADMIN_SECRET_KEY=

# Audit-anchor writer (ADR-0006): limited to the audit-anchor bucket. Wired into the app in P1-50.
S3_ANCHOR_ACCESS_KEY=
S3_ANCHOR_SECRET_KEY=
