# Local development defaults for the Docker stack (compose.yaml).
# Placeholders only. scripts/dev/setup.sh copies this to .env and fills every empty secret with a random value.
# uid/gid that owns the checkout; containers run as it so they can read .env (mode 600) and write storage/.
# Filled by scripts/dev/init-env.sh.
DEV_UID=
DEV_GID=

APP_NAME="Competitive-AIS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=cais
DB_COLLATION=utf8mb4_0900_ai_ci
# Least-privilege accounts (P1-09, docs/02 §6). The app account has table-level DML only, and only
# SELECT/INSERT on append-only tables. Migrations run as the migrator automatically.
DB_USERNAME=cais_app
DB_PASSWORD=
DB_MIGRATOR_USERNAME=cais_migrator
DB_MIGRATOR_PASSWORD=
DB_RETENTION_USERNAME=cais_retention
DB_RETENTION_PASSWORD=
# Automated tests use this database only (phpunit.xml); test runs drop and recreate its tables.
DB_TEST_DATABASE=cais_test

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# Object store (SeaweedFS, ADR-0007). This is the application's key: no governance bypass, no audit-anchor access.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT=http://seaweedfs:8333
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_BUCKET=evidence
EVIDENCE_QUARANTINE_BUCKET=evidence-quarantine
EVIDENCE_BUCKET=evidence
EXPORTS_BUCKET=exports

VITE_APP_NAME="${APP_NAME}"
