# Audit manifest signing key (ADR-0006, P1-50): given to the auditor service only (PO decision O43).
# Placeholders only. scripts/dev/init-env.sh copies this to .secrets/signing.env and fills the seed.

# Ed25519 seed, 64 hex characters. Rotation: docs/10 §6 (keep the old public key in AUDIT_TRUSTED_KEYS).
AUDIT_SIGNING_SEED=
# Public keys of earlier signing keys (64 hex characters each, comma-separated); not secret. Empty until a rotation.
AUDIT_TRUSTED_KEYS=
