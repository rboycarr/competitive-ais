# Service-only secrets (compose.yaml). Never loaded by Laravel.
# Placeholders only. scripts/dev/setup.sh copies this to .env.services and fills every empty value with a random one.
MYSQL_ROOT_PASSWORD=
# cais_readonly: SELECT for backups and reporting (P1-09). Not used by the application.
DB_READONLY_PASSWORD=

# SeaweedFS admin identity: creates buckets and can bypass governance retention. Not given to the application.
S3_ADMIN_ACCESS_KEY=
S3_ADMIN_SECRET_KEY=

# Audit-anchor writer (ADR-0006): limited to the audit-anchor bucket. Wired into the app in P1-50.
S3_ANCHOR_ACCESS_KEY=
S3_ANCHOR_SECRET_KEY=
