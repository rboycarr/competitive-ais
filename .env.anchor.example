# Audit-anchor object-store key (ADR-0006, P1-50): limited to the audit-anchor bucket. Given to SeaweedFS (to verify
# signatures) and the auditor service only (PO decision O43), never to the web, Horizon or scheduler containers.
# Placeholders only. scripts/dev/init-env.sh copies this to .secrets/anchor.env and fills every empty value.
S3_ANCHOR_ACCESS_KEY=
S3_ANCHOR_SECRET_KEY=
